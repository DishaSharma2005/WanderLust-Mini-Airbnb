<%= layout("/layouts/boilerplate") %>

<div class="mt-3 mb-4">
  <h2 style="font-size:1.5rem;font-weight:750;">Wishlist</h2>
  <p class="text-muted mb-0">Stays you’ve saved for later.</p>
</div>

<% if (!wishlist || wishlist.length === 0) { %>
  <div class="text-center py-5 px-3" style="background:#f7f7f7;border-radius:16px;">
    <i class="fa-regular fa-heart fa-2x mb-3" style="color:#ff385c;"></i>
    <h4 class="fw-bold">No saved stays yet</h4>
    <p class="text-muted">Tap the heart on any listing to save it here.</p>
    <a href="/listings" class="btn edit-btn mt-2" style="border-radius:12px;">Explore homes</a>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% for (let listing of wishlist) { %>
      <% if (listing) { %>
        <div class="col">
          <%- include("../includes/listing-card.ejs", { listing, currUser }) %>
        </div>
      <% } %>
    <% } %>
  </div>
<% } %>
