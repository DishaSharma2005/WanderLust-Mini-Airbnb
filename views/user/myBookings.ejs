<%= layout("/layouts/boilerplate") %>

<%
  function nightsOf(booking) {
    if (booking.nights) return booking.nights;
    const ms = new Date(booking.checkOut) - new Date(booking.checkIn);
    return Math.max(1, Math.round(ms / 86400000));
  }
%>

<div class="mt-3 mb-4">
  <h2 style="font-size:1.5rem;font-weight:750;">Trips</h2>
  <p class="text-muted mb-0">Your upcoming and past bookings.</p>
</div>

<% if (!bookings || bookings.length === 0) { %>
  <div class="text-center py-5 px-3" style="background:#f7f7f7;border-radius:16px;">
    <i class="fa-regular fa-calendar fa-2x mb-3" style="color:#ff385c;"></i>
    <h4 class="fw-bold">No trips booked…yet!</h4>
    <p class="text-muted">Time to dust off your bags and start planning your next adventure.</p>
    <a href="/listings" class="btn edit-btn mt-2" style="border-radius:12px;">Start searching</a>
  </div>
<% } else { %>
  <div class="row g-4">
    <% bookings.forEach((booking) => { %>
      <% if (!booking.listing) return; %>
      <% const nights = nightsOf(booking); %>
      <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;">
          <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark">
            <img
              src="<%= booking.listing.image.url %>"
              alt="<%= booking.listing.title %>"
              style="width:100%;height:200px;object-fit:cover;"
            >
          </a>
          <div class="card-body">
            <h5 class="fw-bold mb-1"><%= booking.listing.title %></h5>
            <p class="text-muted small mb-2">
              <%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %>
            </p>
            <p class="mb-1"><strong><%= booking.checkIn.toDateString() %></strong> → <strong><%= booking.checkOut.toDateString() %></strong></p>
            <p class="mb-1 text-muted small"><%= nights %> night<%= nights === 1 ? "" : "s" %> · <%= booking.guests %> guest<%= booking.guests === 1 ? "" : "s" %></p>
            <% if (booking.totalPrice) { %>
              <p class="fw-semibold mb-3">Total ₹<%= booking.totalPrice.toLocaleString("en-IN") %> <span class="text-muted fw-normal">(incl. tax)</span></p>
            <% } else { %>
              <p class="fw-semibold mb-3">₹<%= (booking.listing.price * nights).toLocaleString("en-IN") %> base</p>
            <% } %>
            <form action="/booking/<%= booking._id %>?_method=DELETE" method="POST">
              <button class="btn btn-outline-danger btn-sm rounded-pill" type="submit">Cancel booking</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
