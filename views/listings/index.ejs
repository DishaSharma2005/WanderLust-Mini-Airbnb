<%= layout("/layouts/boilerplate") %>

<%
  const experienceTiles = [
    { label: "Cultural tours", image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=400&q=60", category: "Cities" },
    { label: "Landmarks", image: "https://images.unsplash.com/photo-1505761671935-60b3a7427bad?auto=format&fit=crop&w=400&q=60", category: "Castles" },
    { label: "Food tours", image: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=400&q=60", category: "Farms" },
    { label: "Art workshops", image: "https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?auto=format&fit=crop&w=400&q=60", category: "Rooms" },
    { label: "Cooking", image: "https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=400&q=60", category: "Farms" },
    { label: "Shopping & fashion", image: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=400&q=60", category: "Cities" },
    { label: "Outdoors", image: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=400&q=60", category: "Mountains" },
    { label: "Wellness", image: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=400&q=60", category: "Amazing Pools" },
  ];
%>

  <div id="filters">
    <% for (let cat of categories) { %>
      <a
        href="/listings?category=<%= encodeURIComponent(cat.name) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
        class="filter<%= category === cat.name ? ' active' : '' %>"
      >
        <div><i class="<%= cat.icon %>"></i></div>
        <p><%= cat.name %></p>
      </a>
    <% } %>

    <div class="tax-toggle">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        <label class="form-check-label ms-2" for="flexSwitchCheckDefault"><b>Display total before taxes</b></label>
      </div>
    </div>
  </div>

  <% if (allListing.length === 0) { %>
    <div class="text-center mt-5 mb-5">
      <h3>
        No results found
        <% if (category) { %> in "<%= category %>"<% } %>
        <% if (q) { %> for "<%= q %>"<% } %>
      </h3>
      <a href="/listings" class="btn edit-btn mt-3">Back to all listings</a>
    </div>
  <% } else { %>
    <% if (q || category) { %>
      <div class="mt-3 mb-2 d-flex align-items-center gap-2 flex-wrap">
        <h2 style="font-size:1.2rem;font-weight:750;margin:0;">
          <%= allListing.length %> stay<%= allListing.length === 1 ? '' : 's' %>
          <% if (category) { %> in <%= category %><% } %>
          <% if (q) { %> for "<%= q %>"<% } %>
        </h2>
        <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill">Clear filters</a>
      </div>

      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 mt-1">
        <% for (let listing of allListing) { %>
          <div class="col">
            <%- include("../includes/listing-card.ejs", { listing, currUser }) %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <% for (let section of categorySections) { %>
        <% if (section.listings.length) { %>
          <section class="ab-row" data-rail-section>
            <div class="ab-row-head">
              <h2>Popular homes · <%= section.name %></h2>
              <div class="ab-row-actions">
                <a href="/listings?category=<%= encodeURIComponent(section.name) %>" class="btn btn-sm btn-link text-dark text-decoration-none fw-semibold">Show all</a>
                <button type="button" class="ab-nav-btn" data-dir="-1" aria-label="Scroll left"><i class="fa-solid fa-chevron-left"></i></button>
                <button type="button" class="ab-nav-btn" data-dir="1" aria-label="Scroll right"><i class="fa-solid fa-chevron-right"></i></button>
              </div>
            </div>
            <div class="ab-rail">
              <% for (let listing of section.listings) { %>
                <%- include("../includes/listing-card.ejs", { listing, currUser }) %>
              <% } %>
            </div>
          </section>
        <% } %>
      <% } %>

      <section class="ab-row">
        <div class="ab-row-head">
          <h2>Explore experiences nearby</h2>
        </div>
        <div class="ab-exp-rail">
          <% for (let tile of experienceTiles) { %>
            <a class="ab-exp" href="/listings?category=<%= encodeURIComponent(tile.category) %>">
              <img src="<%= tile.image %>" alt="<%= tile.label %>">
              <span><%= tile.label %></span>
            </a>
          <% } %>
        </div>
      </section>

      <section class="ab-row" id="all-stays">
        <div class="ab-row-head">
          <h2>All stays</h2>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
          <% for (let listing of allListing) { %>
            <div class="col">
              <%- include("../includes/listing-card.ejs", { listing, currUser }) %>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>
  <% } %>

  <button type="button" class="fees-chip" id="feesChip" aria-live="polite">
    Prices include all fees <i class="fa-solid fa-chevron-up"></i>
  </button>

  <script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    const feesChip = document.getElementById("feesChip");

    function applyTaxDisplay(show) {
      document.body.classList.toggle("show-totals", show);
      document.querySelectorAll(".tax-info:not(.price-total)").forEach((info) => {
        info.style.display = show ? "inline" : "none";
      });
      if (feesChip) {
        feesChip.textContent = show
          ? "Showing totals with taxes "
          : "Prices include all fees ";
        const icon = document.createElement("i");
        icon.className = "fa-solid fa-chevron-up";
        feesChip.appendChild(icon);
      }
    }

    if (taxSwitch) {
      taxSwitch.addEventListener("change", () => applyTaxDisplay(taxSwitch.checked));
    }

    if (feesChip && taxSwitch) {
      feesChip.addEventListener("click", () => {
        taxSwitch.checked = !taxSwitch.checked;
        taxSwitch.dispatchEvent(new Event("change"));
        taxSwitch.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }

    document.querySelectorAll("[data-rail-section]").forEach((section) => {
      const rail = section.querySelector(".ab-rail");
      section.querySelectorAll(".ab-nav-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const dir = Number(btn.getAttribute("data-dir") || 1);
          rail.scrollBy({ left: dir * Math.max(rail.clientWidth * 0.8, 260), behavior: "smooth" });
        });
      });
    });
  </script>
