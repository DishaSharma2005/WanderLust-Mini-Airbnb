<% layout("/layouts/boilerplate") %>

<div class="mt-3 mb-4">
  <h2 style="font-size:1.5rem;font-weight:750;">Admin dashboard</h2>
  <p class="text-muted mb-0">Manage listings, reviews, and bookings.</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="p-3 h-100" style="background:#f7f7f7;border-radius:14px;">
      <div class="text-muted small">Listings</div>
      <div class="fs-3 fw-bold"><%= stats.listings %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="p-3 h-100" style="background:#f7f7f7;border-radius:14px;">
      <div class="text-muted small">Reviews</div>
      <div class="fs-3 fw-bold"><%= stats.reviews %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="p-3 h-100" style="background:#f7f7f7;border-radius:14px;">
      <div class="text-muted small">Users</div>
      <div class="fs-3 fw-bold"><%= stats.users %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="p-3 h-100" style="background:#f7f7f7;border-radius:14px;">
      <div class="text-muted small">Bookings</div>
      <div class="fs-3 fw-bold"><%= stats.bookings %></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <h4 class="fw-bold mb-3">All listings</h4>
    <ul class="list-group shadow-sm" style="border-radius:14px;overflow:hidden;">
      <% if (!listings.length) { %>
        <li class="list-group-item text-muted">No listings yet.</li>
      <% } %>
      <% listings.forEach(listing => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
          <div>
            <div class="fw-semibold"><%= listing.title %></div>
            <div class="small text-muted">by <%= listing.owner?.username || "Unknown" %></div>
          </div>
          <form method="POST" action="/admin/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-outline-danger btn-sm rounded-pill" type="submit">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>

  <div class="col-lg-6">
    <h4 class="fw-bold mb-3">Recent bookings</h4>
    <ul class="list-group shadow-sm mb-4" style="border-radius:14px;overflow:hidden;">
      <% if (!bookings.length) { %>
        <li class="list-group-item text-muted">No bookings yet.</li>
      <% } %>
      <% bookings.forEach(booking => { %>
        <li class="list-group-item">
          <div class="fw-semibold"><%= booking.listing?.title || "Deleted listing" %></div>
          <div class="small text-muted">
            <%= booking.user?.username || "User" %> ·
            <%= booking.checkIn.toDateString() %> → <%= booking.checkOut.toDateString() %>
            <% if (booking.totalPrice) { %> · ₹<%= booking.totalPrice.toLocaleString("en-IN") %><% } %>
          </div>
        </li>
      <% }) %>
    </ul>

    <h4 class="fw-bold mb-3">All reviews</h4>
    <ul class="list-group shadow-sm" style="border-radius:14px;overflow:hidden;">
      <% if (!reviews.length) { %>
        <li class="list-group-item text-muted">No reviews yet.</li>
      <% } %>
      <% reviews.forEach(review => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
          <div>
            <div><%= review.comment %></div>
            <div class="small text-muted">
              ★ <%= review.rating %> · <%= review.author?.username || "Unknown" %>
            </div>
          </div>
          <form method="POST" action="/admin/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-outline-danger btn-sm rounded-pill" type="submit">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>
</div>
