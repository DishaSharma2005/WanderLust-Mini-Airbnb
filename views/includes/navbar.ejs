<header class="ab-header">
  <div class="ab-header-top">
    <a class="ab-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
      <span>WanderLust</span>
    </a>

    <nav class="ab-center-tabs" aria-label="Primary">
      <a class="ab-tab active" href="/listings">
        <i class="fa-solid fa-house"></i>
        <span>Homes</span>
      </a>
      <a class="ab-tab" href="/listings?category=Trending">
        <i class="fa-solid fa-binoculars"></i>
        <span>Experiences</span>
      </a>
      <a class="ab-tab" href="/listings?category=Amazing%20Pools">
        <i class="fa-solid fa-bell-concierge"></i>
        <span>Services</span>
      </a>
    </nav>

    <div class="ab-header-right">
      <a class="ab-host-link" href="/listings/new">Become a host</a>
      <button type="button" class="ab-menu-btn" id="abMenuBtn" aria-label="Open profile menu" aria-expanded="false">
        <i class="fas fa-bars"></i>
        <span class="ab-avatar">
          <% if (currUser) { %>
            <%= currUser.username.charAt(0).toUpperCase() %>
          <% } else { %>
            <i class="fa-regular fa-user"></i>
          <% } %>
        </span>
      </button>
    </div>
  </div>

  <div class="ab-search-wrap">
    <form class="ab-search" role="search" action="/listings" method="GET">
      <div class="ab-search-seg">
        <label for="abWhere">Where</label>
        <input
          id="abWhere"
          type="search"
          name="q"
          placeholder="Search destinations"
          value="<%= typeof q !== 'undefined' && q ? q : '' %>"
          aria-label="Search destinations"
        />
      </div>
      <div class="ab-search-seg hide-sm">
        <label for="abCheckIn">Check-in</label>
        <input
          id="abCheckIn"
          type="date"
          name="checkIn"
          value="<%= typeof checkIn !== 'undefined' && checkIn ? checkIn : '' %>"
          aria-label="Check-in date"
        />
      </div>
      <div class="ab-search-seg hide-sm">
        <label for="abCheckOut">Check-out</label>
        <input
          id="abCheckOut"
          type="date"
          name="checkOut"
          value="<%= typeof checkOut !== 'undefined' && checkOut ? checkOut : '' %>"
          aria-label="Check-out date"
        />
      </div>
      <div class="ab-search-seg hide-sm">
        <label for="abWho">Who</label>
        <input
          id="abWho"
          type="number"
          name="guests"
          min="1"
          max="10"
          placeholder="Add guests"
          value="<%= typeof guests !== 'undefined' && guests ? guests : '' %>"
          aria-label="Guests"
        />
      </div>
      <% if (typeof category !== 'undefined' && category) { %>
        <input type="hidden" name="category" value="<%= category %>" />
      <% } %>
      <button class="ab-search-go" type="submit" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>
  </div>

  <div class="ab-dropdown" id="abDropdown">
    <% if (!currUser) { %>
      <a href="/signup"><b>Sign up</b></a>
      <a href="/login">Log in</a>
      <div class="divider"></div>
      <a href="/listings/new">Airbnb your home</a>
      <a href="/wishlist"><i class="fa-regular fa-heart"></i> Wishlist</a>
      <a href="/listings">Explore</a>
    <% } else { %>
      <a href="/wishlist"><i class="fa-solid fa-heart" style="color:#ff385c"></i> Wishlist</a>
      <a href="/booking/mine"><i class="fa-solid fa-calendar-check"></i> My Bookings</a>
      <% if (currUser.role === "admin") { %>
        <a href="/admin/dashboard">Admin Dashboard</a>
      <% } %>
      <div class="divider"></div>
      <a href="/listings/new">Airbnb your home</a>
      <a href="/listings">Explore</a>
      <div class="divider"></div>
      <a href="/logout">Log out</a>
      <div class="divider"></div>
      <a href="#" style="pointer-events:none;color:#717171;font-size:0.82rem;">
        Signed in as <b><%= currUser.username %></b>
      </a>
    <% } %>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("abMenuBtn");
    const menu = document.getElementById("abDropdown");
    if (btn && menu) {
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        const open = menu.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("click", function () {
        menu.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      });

      menu.addEventListener("click", function (e) {
        e.stopPropagation();
      });
    }

    const checkIn = document.getElementById("abCheckIn");
    const checkOut = document.getElementById("abCheckOut");
    if (checkIn && checkOut) {
      const today = new Date().toISOString().slice(0, 10);
      checkIn.min = today;
      checkOut.min = today;
      checkIn.addEventListener("change", () => {
        if (!checkIn.value) return;
        const next = new Date(checkIn.value + "T00:00:00");
        next.setDate(next.getDate() + 1);
        const minOut = next.toISOString().slice(0, 10);
        checkOut.min = minOut;
        if (checkOut.value && checkOut.value <= checkIn.value) {
          checkOut.value = minOut;
        }
      });
    }
  });
</script>
